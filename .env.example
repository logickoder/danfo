# Copy to .env.local (gitignored).

# bankstract-cloud API key this deployment parses with. SERVER-ONLY, never NEXT_PUBLIC_.
# Self-hosters: any bankstract-cloud key works here (grab a test key to start).
DANFO_API_KEY=bsk_test_replace_me

# Public URL of this deployment, for canonical links, the sitemap and share previews.
NEXT_PUBLIC_SITE_URL=https://danfo.logickoder.dev

# Upstream parse API. Default is the hosted bankstract-cloud.
BANKSTRACT_API_URL=https://bankstract.logickoder.dev

# Request header holding the real client IP, set by whatever edge fronts this app.
# Cloudflare: cf-connecting-ip (default). Vercel: x-real-ip. Self-host: whatever your
# reverse proxy sets. Forwarded upstream so bankstract can rate-limit per end user;
# if the header is absent, all users share one bucket (safe but tiny).
CLIENT_IP_HEADER=cf-connecting-ip

# Cloudflare Turnstile, checked server-side in src/app/api/parse/route.ts before every parse.
# Both keys come from the same Turnstile widget in the Cloudflare dashboard; a real site key
# needs its real secret, they are not interchangeable with the test pair below.
# For local dev without a widget yet, Cloudflare's always-pass TEST pair works end to end:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
